{
  "name": "xtream-codec-studio-ui",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run check && vite build",
