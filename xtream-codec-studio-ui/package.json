    "@heroui/styles": "^3.0.5",
    "@uiw/react-codemirror": "^4.25.11",
    "ajv": "8.17.1",
    "lossless-json": "^4.3.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.0",
